{
  "name": "wealthfolio-cas-importer",
  "version": "1.0.0",
  "description": "Import Indian mutual fund CAS statements (CAMS/KFintech) into Wealthfolio",
  "type": "module",
  "main": "dist/addon.js",
  "keywords": [
    "wealthfolio",
    "addon"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio-addon dev",
    "clean": "rm -rf dist",
    "package": "mkdir -p dist assets && find dist -name '*.map' -delete && zip -r dist/$npm_package_name-$npm_package_version.zip manifest.json dist/ assets/ README.md -x '*.map'",
    "bundle": "pnpm clean && pnpm runtime && pnpm build && pnpm package",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "runtime": "node scripts/fetch-runtime.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/sandbox.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.11.0",
    "@wealthfolio/ui": "^3.11.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.20",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@wealthfolio/addon-dev-tools": "^3.11.0",
    "@wealthfolio/addon-sdk": "^3.11.0",
    "@wealthfolio/ui": "^3.11.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "playwright-core": "1.58.2",
    "pyodide": "314.0.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
