{
  "id": "cas-importer",
  "name": "CAS Importer",
  "version": "1.0.0",
  "description": "Import Indian mutual fund CAS statements (CAMS/KFintech) into Wealthfolio",
  "author": "Joel Tony",
  "main": "dist/addon.js",
  "sdkVersion": "3.11.0",
  "minWealthfolioVersion": "3.11.0",
  "enabled": true,
  "contributes": {
    "routes": [{ "id": "cas-importer" }],
    "links": {
      "sidebar": [
        {
          "id": "cas-importer",
          "route": "cas-importer",
          "label": "CAS Importer",
          "icon": "squares-four",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.11.0",
    "@wealthfolio/ui": "^3.11.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "Choose the account each PAN's or folio's transactions go to"
    },
    {
      "category": "activities",
      "functions": ["getAll", "checkImport", "import"],
      "purpose": "Check the statement's transactions against the account's activities, then import them"
    },
    {
      "category": "market-data",
      "functions": ["searchTicker"],
      "purpose": "Find each fund by the ISIN or name printed on the statement, or by what you type"
    },
    {
      "category": "secrets",
      "functions": ["get", "set", "delete"],
      "purpose": "Keep the statement password when you tick Remember, and forget it"
    }
  ],
  "keywords": ["wealthfolio", "addon"],
  "license": "MIT",
  "repository": "https://github.com/jay-tau/wealthfolio-cas-importer"
}
